<Project>
    <PropertyGroup>
        <XdlRuntimeDirectory>$(XdlReleaseDirectory)runtimes/$(NETCoreSdkPortableRuntimeIdentifier)/native/</XdlRuntimeDirectory>
        <XdlBrowserDirectory>$(XdlReleaseDirectory)runtimes/browser-wasm/native/</XdlBrowserDirectory>
        <!-- The headers, the runtime for this machine and the browser archives, unless a project names other XDL targets. -->
        <XdlReleaseTargets Condition="'$(XdlReleaseTargets)' == ''">headers;$(NETCoreSdkPortableRuntimeIdentifier);browser-wasm-net11</XdlReleaseTargets>
    </PropertyGroup>

    <!-- A project that sets UsesXdlRelease gets the release before it builds. -->
    <Target Name="FetchXdlRelease" BeforeTargets="BeforeBuild" Condition="'$(UsesXdlRelease)' == 'true'">
        <MSBuild Projects="$(MSBuildThisFileDirectory)tools/XdlRelease.proj" Properties="XdlTargets=$(XdlReleaseTargets)" />
    </Target>
</Project>
