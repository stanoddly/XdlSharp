<Project Sdk="Microsoft.NET.Sdk">

    <!--
      Packs the runtime of one XDL target as XdlSharp.Native.<rid>, with the files of its release zip at the same paths:
      dotnet pack packaging/XdlSharp.Native -p:XdlRuntimeIdentifier=linux-x64
    -->
    <PropertyGroup>
        <PackageId>XdlSharp.Native.$(XdlRuntimeIdentifier)</PackageId>
        <Description>The $(XdlRuntimeIdentifier) runtime of XDL $(XdlVersion), the altered SDL $(XdlSdlVersion), with SDL_image, SDL_ttf and SDL_mixer built against it, for XdlSharp.</Description>
        <UsesXdlRelease>true</UsesXdlRelease>
        <!-- The browser archives are built for the Emscripten of .NET 11, which the XDL target names. -->
        <XdlTarget>$(XdlRuntimeIdentifier)</XdlTarget>
        <XdlTarget Condition="'$(XdlRuntimeIdentifier)' == 'browser-wasm'">browser-wasm-net11</XdlTarget>
        <XdlReleaseTargets>$(XdlTarget)</XdlReleaseTargets>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
        <!-- The package has no lib folder, so it suits every target framework. -->
        <NoWarn>$(NoWarn);NU5128</NoWarn>
        <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);AddXdlRuntimeToPackage</TargetsForTfmSpecificContentInPackage>
    </PropertyGroup>

    <ItemGroup Condition="'$(XdlRuntimeIdentifier)' == 'browser-wasm'">
        <None Include="buildTransitive/XdlSharp.Native.browser-wasm.targets" Pack="true" PackagePath="buildTransitive/$(PackageId).targets" />
    </ItemGroup>

    <!-- A glob in a target, because the release is fetched during the build. -->
    <Target Name="AddXdlRuntimeToPackage">
        <Error Condition="'$(XdlRuntimeIdentifier)' == ''" Text="Set XdlRuntimeIdentifier to the runtime to pack, such as linux-x64." />
        <ItemGroup>
            <_XdlRuntimeFile Include="$(XdlReleaseDirectory)runtimes/$(XdlRuntimeIdentifier)/native/*" />
            <TfmSpecificPackageFile Include="@(_XdlRuntimeFile)" PackagePath="runtimes/$(XdlRuntimeIdentifier)/native/" />
            <TfmSpecificPackageFile Include="$(XdlReleaseDirectory)THIRD-PARTY-NOTICES.txt" PackagePath="/" />
        </ItemGroup>
        <Error Condition="'@(_XdlRuntimeFile)' == ''" Text="The XDL release has no runtime for $(XdlRuntimeIdentifier) in $(XdlReleaseDirectory)runtimes/." />
    </Target>

</Project>
